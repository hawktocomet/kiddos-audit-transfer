     5	#include <memory>
     6	#include <type_traits>
     7	#include <utility>
     8	#include <vector>
     9	
    10	namespace kiddos::ui {
    11	
    12	class Container : public Element {
    13	public:
    14	    template<typename T, typename... Args>
    15	    T& add(Args&&... args) {
    16	        static_assert(std::is_base_of_v<Element, T>,
    17	                      "Container children must derive from Element");
    18	
    19	        auto child = std::make_unique<T>(
    20	            std::forward<Args>(args)...
    21	        );
    22	
    23	        T& reference = *child;
    24	        children_.push_back(std::move(child));
    25	        return reference;
    26	    }
    27	
    28	    std::size_t child_count() const noexcept {
    29	        return children_.size();
    30	    }
    31	
    32	    Element* child(std::size_t index) noexcept {
    33	        if (index >= children_.size()) return nullptr;
    34	        return children_[index].get();
    35	    }
    36	
    37	    const Element* child(std::size_t index) const noexcept {
    38	        if (index >= children_.size()) return nullptr;
    39	        return children_[index].get();
    40	    }
    41	
    42	protected:
    43	    void draw(Renderer& renderer) override {
    44	        for (auto& element : children_) {
    45	            element->render(renderer);
    46	        }
    47	    }
    48	
    49	private:
    50	    std::vector<std::unique_ptr<Element>> children_;
    51	};
    52	
    53	} // namespace kiddos::ui

