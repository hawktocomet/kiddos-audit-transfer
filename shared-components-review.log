    25	    ui::Rect target,
    26	    float amount
    27	) {
    28	    return {
    29	        interpolate(current.x, target.x, amount),
    30	        interpolate(current.y, target.y, amount),
    31	        interpolate(current.w, target.w, amount),
    32	        interpolate(current.h, target.h, amount)
    33	    };
