#pragma once

#include <SDL.h>
#include <SDL_ttf.h>

namespace kiddos::app {

class SharedShell final {
public:
    SharedShell() = default;
    ~SharedShell();

    SharedShell(const SharedShell&) = delete;
    SharedShell& operator=(const SharedShell&) = delete;

    bool initialize(SDL_Renderer* renderer);
    void render_header();
    void render_footer(bool selected_game);
    void reset() noexcept;

private:
    void draw_text(const char* text, int x, int y);

    SDL_Renderer* renderer_ = nullptr;
    SDL_Texture* logo_ = nullptr;
    SDL_Texture* hints_ = nullptr;
    TTF_Font* font_ = nullptr;
};

} // namespace kiddos::app

----- src/app/selected_game_screen.cpp -----
#include "kiddos/app/selected_game_screen.hpp"

#include "kiddos/app/platform.hpp"

#include <array>

namespace kiddos::app {

namespace {

constexpr std::array<const char*, platform_count> artwork_paths{{
    "assets/artwork/generated/boxart/gb-tetris.png",
    "assets/artwork/generated/boxart/gba-mario-kart-super-circuit.png",
    "assets/artwork/generated/boxart/snes-super-mario-world.png",
    "assets/artwork/generated/boxart/arcade-pac-man.png"
}};

void load_ui_font(ui::Font& font, int size) {
    constexpr std::array<const char*, 3> paths{{
        "/usr/share/fonts/TTF/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/dejavu/DejaVuSans.ttf"
    }};

    for (const char* path : paths) {
        if (font.load(path, size)) return;
    }
}

} // namespace

SelectedGameScreen::SelectedGameScreen(
    SDL_Renderer* renderer,
    int selected_game
) : selected_game_(selected_game) {
    if (selected_game_ < 0 ||
        selected_game_ >= static_cast<int>(platform_count)) {
        selected_game_ = 0;
    }

    artwork_texture_.load(
        renderer,
        artwork_paths[static_cast<std::size_t>(selected_game_)],
        false
    );

    auto& artwork = root().add<ui::Image>(&artwork_texture_);
    artwork.set_bounds({90, 85, 540, 450});
    artwork.set_fit(ui::ImageFit::contain);
    artwork_ = &artwork;

    hints_texture_.load(
        renderer,
        "assets/artwork/generated/selected-game-hints.png",
        false
    );

    auto& hints = root().add<ui::Image>(&hints_texture_);
    hints.set_bounds({0, 678, 720, 42});
    hints.set_fit(ui::ImageFit::contain);
    hints_ = &hints;

    load_ui_font(font_, 28);

    auto& play = root().add<ui::Button>("PLAY");
    play.set_bounds({190, 545, 340, 88});
    play.set_font(&font_);
    play.set_style({
        {18, 43, 83, 255},
        {35, 91, 165, 255},
        {14, 55, 112, 255},
        {35, 39, 50, 255},
        {69, 151, 255, 255},
        {125, 190, 255, 255},
        {255, 255, 255, 255},
        {150, 155, 165, 255}
    });
    play.set_on_activate([this] {
        // This records the UI request; the game-launch backend is separate.
        play_requested_ = true;
    });
    play_button_ = &play;
}

SelectedGameScreen::~SelectedGameScreen() {
    if (hints_) hints_->set_texture(nullptr);
    if (artwork_) artwork_->set_texture(nullptr);
}

} // namespace kiddos::app

----- src/app/shared_shell.cpp -----
#include "kiddos/app/shared_shell.hpp"

#include <SDL_image.h>
#include <algorithm>
#include <cmath>

namespace kiddos::app {
namespace {

constexpr SDL_Color navy{12, 22, 42, 255};
constexpr SDL_Color blue{75, 174, 255, 255};
constexpr SDL_Color white{235, 243, 255, 255};
constexpr SDL_Color muted{145, 173, 207, 255};

void set_color(SDL_Renderer* renderer, SDL_Color color) {
    SDL_SetRenderDrawColor(renderer, color.r, color.g, color.b, color.a);
}

} // namespace

SharedShell::~SharedShell() {
    reset();
}

bool SharedShell::initialize(SDL_Renderer* renderer) {
    reset();
    if (!renderer) return false;

    renderer_ = renderer;

    SDL_Surface* logo_surface =
        IMG_Load("assets/artwork/generated/kiddos-wordmark.png");
    if (logo_surface) {
        logo_ = SDL_CreateTextureFromSurface(renderer_, logo_surface);
        SDL_FreeSurface(logo_surface);
    }

    SDL_Surface* hints_surface =
        IMG_Load("assets/artwork/generated/navigation-hints.png");
    if (hints_surface) {
        hints_ = SDL_CreateTextureFromSurface(renderer_, hints_surface);
        SDL_FreeSurface(hints_surface);
    }

    const char* font_paths[] = {
        "/usr/share/fonts/TTF/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/dejavu/DejaVuSans.ttf"
    };

    for (const char* path : font_paths) {
        font_ = TTF_OpenFont(path, 20);
        if (font_) break;
    }

    return true;
}

void SharedShell::draw_text(const char* text, int x, int y) {
    if (!renderer_ || !font_ || !text) return;

    SDL_Surface* surface = TTF_RenderUTF8_Blended(font_, text, white);
    if (!surface) return;

    SDL_Texture* texture = SDL_CreateTextureFromSurface(renderer_, surface);
    if (texture) {
        SDL_Rect destination{x, y, surface->w, surface->h};
        SDL_RenderCopy(renderer_, texture, nullptr, &destination);
        SDL_DestroyTexture(texture);
    }
    SDL_FreeSurface(surface);
}

void SharedShell::render_header() {
    if (!renderer_) return;

    const SDL_Color body{205, 222, 255, 220};
    const SDL_Color waves{80, 157, 255, 220};
    const SDL_Color charge{67, 157, 255, 240};

    SDL_SetRenderDrawBlendMode(renderer_, SDL_BLENDMODE_BLEND);

    // Original speaker cabinet and flared cone.
    set_color(renderer_, body);
    SDL_Rect cabinet{25, 33, 8, 14};
    SDL_RenderFillRect(renderer_, &cabinet);

    for (int y = 27; y <= 52; ++y) {
        int left = 33;
        if (y < 33) {
            left += (33 - y) * 11 / 6;
        } else if (y > 46) {
            left += (y - 46) * 11 / 6;
        }
        SDL_RenderDrawLine(renderer_, left, y, 44, y);
    }

    // Original two curved sound waves.
    const auto draw_arc = [&](int radius) {
        constexpr double pi = 3.14159265358979323846;
        const int steps = std::max(2, radius * 2);
        SDL_Point previous{};
        for (int step = 0; step <= steps; ++step) {
            const double degrees = -50.0 + 100.0 * step / steps;
            const double radians = degrees * pi / 180.0;
            SDL_Point point{
                47 + static_cast<int>(std::lround(radius * std::cos(radians))),
                39 + static_cast<int>(std::lround(radius * std::sin(radians)))
            };
            if (step > 0) {
                SDL_RenderDrawLine(renderer_, previous.x, previous.y,
                                   point.x, point.y);
            }
            previous = point;
        }
    };
    set_color(renderer_, waves);
    draw_arc(6);
    draw_arc(12);

    // Original battery outline, terminal, and charge fill.
    set_color(renderer_, body);
    SDL_Rect battery{657, 27, 34, 19};
    SDL_Rect terminal{691, 33, 4, 7};
    SDL_RenderDrawRect(renderer_, &battery);
    SDL_RenderFillRect(renderer_, &terminal);

    set_color(renderer_, charge);
    SDL_Rect fill{661, 31, 22, 11};
    SDL_RenderFillRect(renderer_, &fill);

    // Original wordmark dimensions and placement.
    if (logo_) {
        SDL_Rect destination{195, 5, 330, 61};
        SDL_RenderCopy(renderer_, logo_, nullptr, &destination);
    }
}

void SharedShell::render_footer(bool selected_game) {
    if (!renderer_ || selected_game) return;

    // The carousel keeps its original full-width navigation artwork.
    if (hints_) {
        SDL_Rect destination{0, 682, 720, 34};
        SDL_RenderCopy(renderer_, hints_, nullptr, &destination);
    }
}

void SharedShell::reset() noexcept {
    if (logo_) {
        SDL_DestroyTexture(logo_);
        logo_ = nullptr;
    }
    if (hints_) {
        SDL_DestroyTexture(hints_);
        hints_ = nullptr;
    }
    if (font_) {
        TTF_CloseFont(font_);
        font_ = nullptr;
    }
    renderer_ = nullptr;
}

} // namespace kiddos::app

----- tests/app_selected_game_screen_test.cpp -----
#include "kiddos/app/selected_game_screen.hpp"

#include "kiddos/ui/button.hpp"
#include "kiddos/ui/image.hpp"
#include "kiddos/ui/label.hpp"
#include "kiddos/ui/screen_manager.hpp"

#include <SDL.h>
#include <SDL_image.h>

#include <cassert>
#include <unistd.h>

namespace {

void test_screen_structure_and_play_action() {
    kiddos::app::SelectedGameScreen screen(nullptr, 1);

    assert(screen.selected_game() == 1);
    assert(!screen.play_requested());
    assert(screen.root().child_count() == 3);

    auto* artwork = dynamic_cast<kiddos::ui::Image*>(
        screen.root().child(0));
    auto* hints = dynamic_cast<kiddos::ui::Image*>(
        screen.root().child(1));
    auto* play = dynamic_cast<kiddos::ui::Button*>(
        screen.root().child(2));
    assert(artwork);
    assert(hints);
    assert(hints->bounds().x == 0);
    assert(hints->bounds().y == 678);
    assert(hints->bounds().w == 720);
    assert(hints->bounds().h == 42);
    assert(artwork->bounds().x == 90);
    assert(artwork->bounds().y == 85);
    assert(artwork->bounds().w == 540);
    assert(artwork->bounds().h == 450);

    assert(play);
    assert(play->focusable());
    assert(play->label() == "PLAY");
    assert(play->bounds().x == 190);
    assert(play->bounds().y == 545);

    kiddos::ui::ScreenManager manager;
    assert(manager.push(std::make_unique<kiddos::app::SelectedGameScreen>(
        nullptr, 1)));
    assert(manager.handle_action(kiddos::ui::UIAction::Confirm));

    auto* active =
        dynamic_cast<kiddos::app::SelectedGameScreen*>(manager.current());
    assert(active);
    assert(active->play_requested());
}

void test_invalid_game_index_is_safe() {
    kiddos::app::SelectedGameScreen negative(nullptr, -1);
    kiddos::app::SelectedGameScreen too_large(nullptr, 999);

    assert(negative.selected_game() == 0);
    assert(too_large.selected_game() == 0);
}

void test_artwork_renders() {
    assert(SDL_Init(0) == 0);
    IMG_Init(IMG_INIT_PNG);
    assert(chdir(KIDDOS_SOURCE_DIR) == 0);

    SDL_Surface* surface = SDL_CreateRGBSurfaceWithFormat(
        0, 720, 720, 32, SDL_PIXELFORMAT_RGBA32);
    assert(surface);

    SDL_Renderer* native = SDL_CreateSoftwareRenderer(surface);
    assert(native);

    {
        kiddos::ui::Renderer renderer(native);
        kiddos::app::SelectedGameScreen screen(native, 1);

        renderer.clear({8, 15, 35, 255});
        screen.render(renderer);

        // The artwork area is populated by the selected game's cover.
        const auto* bytes =
            static_cast<const unsigned char*>(surface->pixels);
        bool changed = false;
        for (int y = 85; y < 535 && !changed; ++y) {
            for (int x = 90; x < 630; ++x) {
                const auto* pixel = bytes + y * surface->pitch + x * 4;
                if (pixel[0] != 8 || pixel[1] != 15 || pixel[2] != 35) {
                    changed = true;
                    break;
                }
            }
        }
        assert(changed);
    }

    SDL_DestroyRenderer(native);
    SDL_FreeSurface(surface);
    IMG_Quit();
    SDL_Quit();
}

} // namespace

int main() {
    test_screen_structure_and_play_action();
    test_invalid_game_index_is_safe();
    test_artwork_renders();
    return 0;
}

