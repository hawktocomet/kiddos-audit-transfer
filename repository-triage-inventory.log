===== BUILD CONFIGURATION =====
cmake_minimum_required(VERSION 3.20)

project(KiddOS
    VERSION 0.2.0
    DESCRIPTION "A child-friendly gaming environment for the Retro Pixel Pocket"
    LANGUAGES CXX
)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(PkgConfig REQUIRED)
pkg_check_modules(SDL2 REQUIRED IMPORTED_TARGET sdl2)
pkg_check_modules(SDL2_TTF REQUIRED IMPORTED_TARGET SDL2_ttf)
pkg_check_modules(SDL2_IMAGE REQUIRED IMPORTED_TARGET SDL2_image)

add_library(kiddos_ui STATIC
    src/ui/renderer.cpp
    src/ui/layout.cpp
    src/ui/focus.cpp
    src/ui/button.cpp
    src/ui/controller.cpp
    src/ui/font.cpp
    src/ui/text.cpp
    src/ui/texture.cpp
    src/ui/image.cpp
    src/ui/label.cpp
    src/ui/panel.cpp
    src/ui/progress_bar.cpp
    src/ui/toggle.cpp
    src/ui/slider.cpp
    src/ui/theme.cpp
    src/ui/list_view.cpp
    src/ui/checkbox.cpp
    src/ui/radio_group.cpp
    src/ui/select.cpp
    src/ui/text_input.cpp
    src/ui/text_input_interaction.cpp
    src/ui/screen.cpp
    src/ui/screen_manager.cpp
)

add_library(KiddOS::UI ALIAS kiddos_ui)
target_include_directories(kiddos_ui PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
    $<INSTALL_INTERFACE:include>
)
target_link_libraries(kiddos_ui PUBLIC PkgConfig::SDL2 PkgConfig::SDL2_TTF PkgConfig::SDL2_IMAGE)

target_compile_options(kiddos_ui PRIVATE
    -Wall
    -Wextra
    -Wpedantic
)

add_executable(kiddos
    src/main.cpp
    src/app/application.cpp
    src/app/home_carousel_screen.cpp
    src/app/selected_game_screen.cpp
    src/platform/sdl_platform.cpp

    src/app/shared_shell.cpp
)

target_include_directories(kiddos PRIVATE include)
target_link_libraries(kiddos PRIVATE kiddos_ui)

target_compile_options(kiddos PRIVATE
    -Wall
    -Wextra
    -Wpedantic
)

include(CTest)

