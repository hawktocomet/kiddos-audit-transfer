#include "kiddos/ui/select.hpp"
#include "kiddos/ui/text.hpp"

#include <algorithm>
#include <utility>

namespace kiddos::ui {

Select::Select(std::vector<std::string> options, int selected) {
    set_focusable(true);
    set_options(std::move(options));
    if (!options_.empty()) set_selected(selected);
}

void Select::set_options(std::vector<std::string> options) {
    options_ = std::move(options);
    selected_ = options_.empty() ? -1 : 0;
}

const std::vector<std::string>& Select::options() const noexcept {
    return options_;
}

bool Select::set_selected(int index) {
    if (!visible() || !enabled() || index < 0 ||
        index >= static_cast<int>(options_.size())) return false;
    if (selected_ == index) return true;

    selected_ = index;
    if (on_change_) on_change_(selected_);
    return true;
}

int Select::selected() const noexcept {
    return selected_;
}

const std::string* Select::selected_option() const noexcept {
    if (selected_ < 0 || selected_ >= static_cast<int>(options_.size()))
        return nullptr;
    return &options_[selected_];
}

bool Select::select_next() {
    if (options_.empty() || !visible() || !enabled()) return false;
    return set_selected((selected_ + 1) % static_cast<int>(options_.size()));
}

bool Select::select_previous() {
    if (options_.empty() || !visible() || !enabled()) return false;
    const int count = static_cast<int>(options_.size());
    return set_selected((selected_ - 1 + count) % count);
}

void Select::set_font(const Font* font) noexcept {
    font_ = font;
}

const Font* Select::font() const noexcept {
    return font_;
}

void Select::set_style(SelectStyle style) noexcept {
    style_ = style;
}

const SelectStyle& Select::style() const noexcept {
    return style_;
}

void Select::set_on_change(std::function<void(int)> callback) {
    on_change_ = std::move(callback);
}

void Select::draw(Renderer& renderer) {
    const Rect area = bounds();
    if (area.empty()) return;

    renderer.fill_rect(area, style_.background);
    renderer.outline_rect(
        area, focused() ? style_.focused_border : style_.border);

    const Color foreground = enabled() ? style_.text : style_.disabled_text;
    const int mid_y = area.y + area.h / 2;
    const int arrow_size = std::max(2, std::min(7, area.h / 5));
    const int left_x = area.x + std::max(5, area.h / 3);
    const int right_x = area.x + area.w - std::max(5, area.h / 3);

    renderer.draw_line(
        {left_x + arrow_size, mid_y - arrow_size},
        {left_x, mid_y}, style_.arrow);
    renderer.draw_line(
        {left_x, mid_y},
        {left_x + arrow_size, mid_y + arrow_size}, style_.arrow);

    renderer.draw_line(
        {right_x - arrow_size, mid_y - arrow_size},
        {right_x, mid_y}, style_.arrow);
    renderer.draw_line(
        {right_x, mid_y},
        {right_x - arrow_size, mid_y + arrow_size}, style_.arrow);

    if (font_ && font_->valid()) {
        const Rect text_area{
            area.x + arrow_size + 12,
            area.y,
            area.w - (arrow_size * 2 + 24),
            area.h
        };
        if (!text_area.empty() && selected_option()) {
            TextRenderer text(renderer);
            text.draw_centered(*selected_option(), *font_, text_area,
                               foreground);
        }
    }
}

}

----- src/ui/slider.cpp -----
#include "kiddos/ui/slider.hpp"

#include <algorithm>
#include <utility>

namespace kiddos::ui {

Slider::Slider(int value, int minimum, int maximum) {
    set_range(minimum, maximum);
    set_value(value);
    set_focusable(true);
}

void Slider::set_value(int value) {
    const int next = std::clamp(value, minimum_, maximum_);
    if (next == value_) return;

    value_ = next;
    if (on_change_) on_change_(value_);
}

int Slider::value() const noexcept {
    return value_;
}

void Slider::set_range(int minimum, int maximum) {
    if (maximum < minimum) std::swap(minimum, maximum);

    minimum_ = minimum;
    maximum_ = maximum;
    set_value(value_);
}

int Slider::minimum() const noexcept {
    return minimum_;
}

int Slider::maximum() const noexcept {
    return maximum_;
}

void Slider::set_step(int step) noexcept {
    step_ = std::max(1, step);
}

int Slider::step() const noexcept {
    return step_;
}

bool Slider::adjust(int direction) {
    if (!visible() || !enabled() || direction == 0) return false;

    const int delta = direction > 0 ? step_ : -step_;
    const long long next = static_cast<long long>(value_) + delta;
    set_value(static_cast<int>(std::clamp(
        next,
        static_cast<long long>(minimum_),
        static_cast<long long>(maximum_)
    )));
    return true;
}

void Slider::set_style(SliderStyle style) noexcept {
    style_ = style;
}

const SliderStyle& Slider::style() const noexcept {
    return style_;
}

void Slider::set_on_change(std::function<void(int)> callback) {
    on_change_ = std::move(callback);
}

void Slider::draw(Renderer& renderer) {
    const Rect area = bounds();
    if (area.empty()) return;

    const int track_height = std::min(area.h, std::max(1, area.h / 5));
    const int track_y = area.y + (area.h - track_height) / 2;
    const Rect track{area.x, track_y, area.w, track_height};

    renderer.fill_rect(track, style_.track);

    const long long range =
        static_cast<long long>(maximum_) - minimum_;
    const long long offset =
        static_cast<long long>(value_) - minimum_;

    const int position = range == 0
        ? 0
        : static_cast<int>(offset * area.w / range);

    if (position > 0) {
        renderer.fill_rect(
            {area.x, track_y, position, track_height},
            style_.fill
        );
    }

    const int knob_size = std::min(
        area.w,
        std::min(area.h, std::max(6, area.h / 2))
    );
    const int knob_x = std::clamp(
        area.x + position - knob_size / 2,
        area.x,
        area.x + area.w - knob_size
    );

    renderer.fill_rect(
        {knob_x, area.y + (area.h - knob_size) / 2, knob_size, knob_size},
        style_.knob
    );

    if (focused()) {
        renderer.outline_rect(area, style_.focused_border);
    }
}

}

----- src/ui/text.cpp -----
#include "kiddos/ui/text.hpp"

namespace kiddos::ui {
TextRenderer::TextRenderer(Renderer& renderer) noexcept
    : renderer_(renderer) {}

bool TextRenderer::draw(const std::string& text, const Font& font,
                        Point position, Color color) {
    if (!renderer_.valid() || !font.valid() || text.empty()) return false;
    SDL_Color tint{color.r, color.g, color.b, color.a};
    SDL_Surface* surface =
        TTF_RenderUTF8_Blended(font.native(), text.c_str(), tint);
    if (!surface) return false;
    SDL_Texture* texture =
        SDL_CreateTextureFromSurface(renderer_.native(), surface);
    if (!texture) {
        SDL_FreeSurface(surface);
        return false;
    }
    SDL_Rect destination{position.x, position.y, surface->w, surface->h};
    const int result =
        SDL_RenderCopy(renderer_.native(), texture, nullptr, &destination);
    SDL_DestroyTexture(texture);
    SDL_FreeSurface(surface);
    return result == 0;
}

bool TextRenderer::draw_centered(const std::string& text, const Font& font,
                                 Rect area, Color color) {
    if (!font.valid() || text.empty() || area.empty()) return false;
    int width = 0;
    int height = 0;
    if (TTF_SizeUTF8(font.native(), text.c_str(), &width, &height) != 0)
        return false;
    return draw(text, font,
        {area.x + (area.w - width) / 2,
         area.y + (area.h - height) / 2}, color);
}
}

----- src/ui/text_input.cpp -----
#include "kiddos/ui/text_input.hpp"
#include "kiddos/ui/text.hpp"

#include <algorithm>
#include <utility>

namespace kiddos::ui {

TextInput::TextInput(std::string text) {
    set_focusable(true);
    set_text(std::move(text));
}

std::size_t TextInput::previous_boundary(const std::string& text,
                                         std::size_t position) noexcept {
    if (position == 0) return 0;
    --position;
    while (position > 0 &&
           (static_cast<unsigned char>(text[position]) & 0xC0) == 0x80)
        --position;
    return position;
}

std::size_t TextInput::next_boundary(const std::string& text,
                                     std::size_t position) noexcept {
    if (position >= text.size()) return text.size();
    ++position;
    while (position < text.size() &&
           (static_cast<unsigned char>(text[position]) & 0xC0) == 0x80)
        ++position;
    return position;
}

std::size_t TextInput::count_codepoints(const std::string& text) noexcept {
    std::size_t count = 0;
    for (unsigned char c : text)
        if ((c & 0xC0) != 0x80) ++count;
    return count;
}

void TextInput::set_text(std::string text) {
    if (count_codepoints(text) > max_length_) {
        std::size_t position = 0;
        for (std::size_t i = 0; i < max_length_; ++i)
            position = next_boundary(text, position);
        text.resize(position);
    }
    if (text_ == text) return;
    text_ = std::move(text);
    cursor_ = text_.size();
    notify_change();
}

const std::string& TextInput::text() const noexcept {
    return text_;
}

void TextInput::set_placeholder(std::string placeholder) {
    placeholder_ = std::move(placeholder);
}

const std::string& TextInput::placeholder() const noexcept {
    return placeholder_;
}

void TextInput::set_max_length(std::size_t length) {
    max_length_ = length;
    set_text(text_);
}

std::size_t TextInput::max_length() const noexcept {
    return max_length_;
}

bool TextInput::insert_text(const std::string& value) {
    if (!enabled() || !visible() || value.empty()) return false;

    const std::size_t current = count_codepoints(text_);
    const std::size_t available =
        current >= max_length_ ? 0 : max_length_ - current;
    const std::size_t incoming = count_codepoints(value);
    if (available == 0) return false;

    std::size_t end = value.size();
    if (incoming > available) {
        end = 0;
        for (std::size_t i = 0; i < available; ++i)
            end = next_boundary(value, end);
    }

    text_.insert(cursor_, value, 0, end);
    cursor_ += end;
    notify_change();
    return true;
}

bool TextInput::backspace() {
    if (!enabled() || !visible() || cursor_ == 0) return false;
    const std::size_t start = previous_boundary(text_, cursor_);
    text_.erase(start, cursor_ - start);
    cursor_ = start;
    notify_change();
    return true;
}

bool TextInput::delete_forward() {
    if (!enabled() || !visible() || cursor_ >= text_.size()) return false;
    const std::size_t end = next_boundary(text_, cursor_);
    text_.erase(cursor_, end - cursor_);
    notify_change();
    return true;
}

void TextInput::move_cursor_left() noexcept {
    cursor_ = previous_boundary(text_, cursor_);
}

void TextInput::move_cursor_right() noexcept {
    cursor_ = next_boundary(text_, cursor_);
}

void TextInput::move_cursor_home() noexcept {
    cursor_ = 0;
}

void TextInput::move_cursor_end() noexcept {
    cursor_ = text_.size();
}

std::size_t TextInput::cursor_position() const noexcept {
    return cursor_;
}

void TextInput::set_cursor_position(std::size_t position) noexcept {
    position = std::min(position, text_.size());
    while (position > 0 && position < text_.size() &&
           (static_cast<unsigned char>(text_[position]) & 0xC0) == 0x80)
        --position;
    cursor_ = position;
}

void TextInput::set_font(const Font* font) noexcept {
    font_ = font;
}

const Font* TextInput::font() const noexcept {
    return font_;
}

void TextInput::set_style(TextInputStyle style) noexcept {
    style_ = style;
}

const TextInputStyle& TextInput::style() const noexcept {
    return style_;
}

void TextInput::set_on_change(
    std::function<void(const std::string&)> callback) {
    on_change_ = std::move(callback);
}

void TextInput::notify_change() {
    if (on_change_) on_change_(text_);
}

void TextInput::draw(Renderer& renderer) {
    const Rect area = bounds();
    if (area.empty()) return;

    renderer.fill_rect(area, style_.background);
    renderer.outline_rect(
        area, focused() ? style_.focused_border : style_.border);

    if (!font_ || !font_->valid()) return;

    const std::string& displayed = text_.empty() ? placeholder_ : text_;
    const Color foreground = !enabled()
        ? style_.disabled_text
        : (text_.empty() ? style_.placeholder : style_.text);

    const int padding = 8;
    const Rect text_area{
        area.x + padding, area.y + padding / 2,
        std::max(0, area.w - padding * 2),
        std::max(0, area.h - padding)
    };

    if (!displayed.empty()) {
        TextRenderer text_renderer(renderer);
        text_renderer.draw(displayed, *font_,
                           {text_area.x, text_area.y}, foreground);
    }

    if (focused() && enabled()) {
        const std::string before = text_.substr(0, cursor_);
        int cursor_width = 0;
        int cursor_height = 0;
        if (TTF_SizeUTF8(font_->native(), before.c_str(),
                         &cursor_width, &cursor_height) == 0) {
            const int x = text_area.x + cursor_width;
            const int y = text_area.y;
            renderer.draw_line(
                {x, y}, {x, y + std::min(cursor_height, text_area.h)},
                style_.cursor);
        }
    }
}

}

----- src/ui/text_input_interaction.cpp -----
#include "kiddos/ui/text_input_interaction.hpp"
#include "kiddos/ui/text_input.hpp"

namespace kiddos::ui {

TextInputInteraction::TextInputInteraction(FocusManager& focus) noexcept
    : focus_(focus) {
}

bool TextInputInteraction::insert_text(const std::string& text) {
    auto* input = dynamic_cast<TextInput*>(focus_.focused());
    if (!input || !input->enabled() || !input->visible()) return false;
    return input->insert_text(text);
}

bool TextInputInteraction::handle(TextInputKey key) {
    auto* input = dynamic_cast<TextInput*>(focus_.focused());
    if (!input || !input->enabled() || !input->visible()) return false;

    switch (key) {
        case TextInputKey::Backspace:
            input->backspace();
            return true;
        case TextInputKey::Delete:
            input->delete_forward();
            return true;
        case TextInputKey::Left:
            input->move_cursor_left();
            return true;
        case TextInputKey::Right:
            input->move_cursor_right();
            return true;
        case TextInputKey::Home:
            input->move_cursor_home();
            return true;
        case TextInputKey::End:
            input->move_cursor_end();
            return true;
    }

    return false;
}

} // namespace kiddos::ui

