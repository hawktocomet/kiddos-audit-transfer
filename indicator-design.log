     1	#include "kiddos/ui/progress_bar.hpp"
     2	
     3	#include <algorithm>
     4	
     5	namespace kiddos::ui {
     6	
     7	ProgressBar::ProgressBar(int value) {
     8	    set_value(value);
     9	}
    10	
    11	void ProgressBar::set_value(int value) noexcept {
    12	    value_ = std::clamp(value, 0, 100);
    13	}
    14	
    15	int ProgressBar::value() const noexcept {
    16	    return value_;
    17	}
    18	
    19	void ProgressBar::set_orientation(ProgressOrientation orientation) noexcept {
    20	    orientation_ = orientation;
    21	}
    22	
    23	ProgressOrientation ProgressBar::orientation() const noexcept {
    24	    return orientation_;
    25	}
    26	
    27	void ProgressBar::set_style(ProgressBarStyle style) noexcept {
    28	    style.border_thickness = std::max(0, style.border_thickness);
    29	    style_ = style;
    30	}
    31	
    32	const ProgressBarStyle& ProgressBar::style() const noexcept {
    33	    return style_;
    34	}
    35	
    36	void ProgressBar::draw(Renderer& renderer) {
    37	    const Rect area = bounds();
    38	    if (area.empty()) return;
    39	
    40	    renderer.fill_rect(area, style_.background);
    41	
    42	    const int border = std::min(
    43	        style_.border_thickness,
    44	        std::min(area.w, area.h) / 2
    45	    );
    46	
    47	    if (border > 0) {
    48	        renderer.outline_rect(area, style_.border);
    49	    }
    50	
    51	    const Rect inner{
    52	        area.x + border,
    53	        area.y + border,
    54	        area.w - border * 2,
    55	        area.h - border * 2
    56	    };
    57	
    58	    if (inner.empty() || value_ == 0) return;
    59	
    60	    Rect fill_area = inner;
    61	
    62	    if (orientation_ == ProgressOrientation::horizontal) {
    63	        fill_area.w = inner.w * value_ / 100;
    64	    } else {
    65	        fill_area.h = inner.h * value_ / 100;
    66	        fill_area.y = inner.y + inner.h - fill_area.h;
    67	    }
    68	
    69	    if (!fill_area.empty()) {
    70	        renderer.fill_rect(fill_area, style_.fill);
    71	    }
    72	}
    73	
    74	}

