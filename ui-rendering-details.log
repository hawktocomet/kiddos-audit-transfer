#pragma once
#include <SDL_ttf.h>
#include <string>

namespace kiddos::ui {
class Font final {
public:
    Font() = default;
    ~Font();
    Font(const Font&) = delete;
    Font& operator=(const Font&) = delete;
    Font(Font&& other) noexcept;
    Font& operator=(Font&& other) noexcept;
    bool load(const std::string& path, int point_size);
    void reset() noexcept;
    bool valid() const noexcept;
    TTF_Font* native() const noexcept;
private:
    TTF_Font* font_ = nullptr;
};
}

========== src/ui/font.cpp ==========
#include "kiddos/ui/font.hpp"
#include <utility>

namespace kiddos::ui {
Font::~Font() { reset(); }
Font::Font(Font&& other) noexcept
    : font_(std::exchange(other.font_, nullptr)) {}
Font& Font::operator=(Font&& other) noexcept {
    if (this != &other) {
        reset();
        font_ = std::exchange(other.font_, nullptr);
    }
    return *this;
}
bool Font::load(const std::string& path, int point_size) {
    reset();
    if (path.empty() || point_size <= 0) return false;
    font_ = TTF_OpenFont(path.c_str(), point_size);
    return font_ != nullptr;
}
void Font::reset() noexcept {
    if (font_) {
        TTF_CloseFont(font_);
        font_ = nullptr;
    }
}
bool Font::valid() const noexcept { return font_ != nullptr; }
TTF_Font* Font::native() const noexcept { return font_; }
}

