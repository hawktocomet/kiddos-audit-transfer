#pragma once
#include "kiddos/ui/container.hpp"
#include "kiddos/ui/controller.hpp"
#include "kiddos/ui/text_input_interaction.hpp"
#include "kiddos/platform/text_input_event.hpp"

namespace kiddos::ui {
class Screen {
public:
    Screen() noexcept;
    virtual ~Screen() = default;
    Screen(const Screen&) = delete;
    Screen& operator=(const Screen&) = delete;
    Container& root() noexcept;
    FocusManager& focus() noexcept;
    virtual void on_enter() {}
    virtual void on_exit() {}
    virtual void on_suspend() {}
    virtual void on_resume() {}
    virtual void update(float) {}
    virtual void render(Renderer& renderer);
    bool handle_action(UIAction action);
    bool handle_text_input(const ::kiddos::TextInputEvent& event);
private:
    Container root_;
    FocusManager focus_;
    ControllerInteraction controller_;
    TextInputInteraction text_input_;
};
}

========== src/ui/screen.cpp ==========
#include "kiddos/ui/screen.hpp"
namespace kiddos::ui {
Screen::Screen() noexcept : focus_(root_), controller_(focus_), text_input_(focus_) {}
Container& Screen::root() noexcept { return root_; }
FocusManager& Screen::focus() noexcept { return focus_; }
void Screen::render(Renderer& renderer) { root_.render(renderer); }
bool Screen::handle_action(UIAction action) {
    if (!focus_.focused()) focus_.focus_first();
    return controller_.handle(action);
}
bool Screen::handle_text_input(const ::kiddos::TextInputEvent& event) {
    switch (event.type) {
    case ::kiddos::TextInputEventType::Text: return text_input_.insert_text(event.text);
    case ::kiddos::TextInputEventType::Backspace: return text_input_.handle(TextInputKey::Backspace);
    case ::kiddos::TextInputEventType::Delete: return text_input_.handle(TextInputKey::Delete);
    case ::kiddos::TextInputEventType::Left: return text_input_.handle(TextInputKey::Left);
    case ::kiddos::TextInputEventType::Right: return text_input_.handle(TextInputKey::Right);
    case ::kiddos::TextInputEventType::Home: return text_input_.handle(TextInputKey::Home);
    case ::kiddos::TextInputEventType::End: return text_input_.handle(TextInputKey::End);
    }
    return false;
}
}

========== src/app/application.cpp ==========
#include "kiddos/app/application.hpp"

#include "kiddos/app/home_carousel_screen.hpp"
#include "kiddos/app/selected_game_screen.hpp"
#include "kiddos/app/shared_shell.hpp"
#include "kiddos/app/ui_action_mapping.hpp"

#include <SDL_image.h>

#include <chrono>
#include <memory>
#include <thread>
#include <SDL_ttf.h>

namespace kiddos {

Application::Application(Platform& platform)
    : platform_(platform) {
}

int Application::run() {
    IMG_Init(IMG_INIT_PNG);
    if (!platform_.initialize()) {
        platform_.shutdown();
        IMG_Quit();
        return 1;
    }

    // The UI renderer is a non-owning adapter around the platform renderer.
    ui_renderer_.attach(platform_.native_renderer());
    if (TTF_Init() != 0) {
        IMG_Quit();
        platform_.shutdown();
        return 1;
    }

    app::SharedShell shell;
    if (!shell.initialize(platform_.native_renderer())) {
        TTF_Quit();
        IMG_Quit();
        platform_.shutdown();
        return 1;
    }

    screens_.push(std::make_unique<app::HomeCarouselScreen>(
        platform_.native_renderer()));

    running_ = true;

    while (running_) {
        Action action = Action::None;

        while (platform_.poll_action(action)) {
            handle_action(action);
            if (!running_) break;
        }

        if (running_) {
            screens_.update(0.008f);
            render(shell);
            std::this_thread::sleep_for(std::chrono::milliseconds(8));
        }
    }

    // Screens and their textures must be destroyed before the SDL renderer.
    screens_.clear();
    shell.reset();
    TTF_Quit();
    IMG_Quit();
    platform_.shutdown();
    return 0;
}

void Application::handle_action(Action action) {
    if (action == Action::Quit) {
        running_ = false;
        return;
    }

    const auto ui_action = app::to_ui_action(action);
    if (!ui_action) return;

    // Back pops a child screen, but never removes the home screen.
    if (*ui_action == ui::UIAction::Back) {
        if (screens_.depth() > 1) {
            screens_.handle_action(*ui_action);
        }
        return;
    }

    // Let the active screen handle its own controls first. This is how
    // Confirm activates the Play button on Selected Game.
    if (screens_.handle_action(*ui_action)) return;

    auto* home = dynamic_cast<app::HomeCarouselScreen*>(screens_.current());
    if (!home) return;

    switch (*ui_action) {
        case ui::UIAction::Left:
            selected_game_ =
                (selected_game_ + game_count_ - 1) % game_count_;
            home->set_selected_game(selected_game_);
            break;

        case ui::UIAction::Right:
            selected_game_ = (selected_game_ + 1) % game_count_;
            home->set_selected_game(selected_game_);
            break;

        case ui::UIAction::Confirm:
            screens_.push(std::make_unique<app::SelectedGameScreen>(
                platform_.native_renderer(), selected_game_));
            break;

        case ui::UIAction::Up:
        case ui::UIAction::Down:
        case ui::UIAction::Back:
            break;
    }
}

void Application::render(app::SharedShell& shell) {
    platform_.begin_frame();
    screens_.render(ui_renderer_);

    const bool selected_game =
        dynamic_cast<app::SelectedGameScreen*>(screens_.current()) != nullptr;

    shell.render_header();
    shell.render_footer(selected_game);

    platform_.present();
}

} // namespace kiddos
