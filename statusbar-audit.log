    21	SharedShell::~SharedShell() {
    22	    reset();
    23	}
    24	
    25	bool SharedShell::initialize(SDL_Renderer* renderer) {
    26	    reset();
    27	    if (!renderer) return false;
    28	
    29	    renderer_ = renderer;
    30	
    31	    SDL_Surface* logo_surface =
    32	        IMG_Load("assets/artwork/generated/kiddos-wordmark.png");
    33	    if (logo_surface) {
    34	        logo_ = SDL_CreateTextureFromSurface(renderer_, logo_surface);
    35	        SDL_FreeSurface(logo_surface);
    36	    }
    37	
    38	    SDL_Surface* hints_surface =
    39	        IMG_Load("assets/artwork/generated/navigation-hints.png");
    40	    if (hints_surface) {
    41	        hints_ = SDL_CreateTextureFromSurface(renderer_, hints_surface);
    42	        SDL_FreeSurface(hints_surface);
    43	    }
    44	
    45	    const char* font_paths[] = {
    46	        "/usr/share/fonts/TTF/DejaVuSans.ttf",
    47	        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    48	        "/usr/share/fonts/dejavu/DejaVuSans.ttf"
    49	    };
    50	
    51	    for (const char* path : font_paths) {
    52	        font_ = TTF_OpenFont(path, 20);
    53	        if (font_) break;
    54	    }
    55	
    56	    return true;
    57	}
    58	
    59	void SharedShell::draw_text(const char* text, int x, int y) {
    60	    if (!renderer_ || !font_ || !text) return;
    61	
    62	    SDL_Surface* surface = TTF_RenderUTF8_Blended(font_, text, white);
    63	    if (!surface) return;
    64	
    65	    SDL_Texture* texture = SDL_CreateTextureFromSurface(renderer_, surface);
    66	    if (texture) {
    67	        SDL_Rect destination{x, y, surface->w, surface->h};
    68	        SDL_RenderCopy(renderer_, texture, nullptr, &destination);
    69	        SDL_DestroyTexture(texture);
    70	    }
    71	    SDL_FreeSurface(surface);
    72	}
    73	
    74	void SharedShell::render_header() {
    75	    if (!renderer_) return;
    76	
    77	    const SDL_Color body{205, 222, 255, 220};
    78	    const SDL_Color waves{80, 157, 255, 220};
    79	    const SDL_Color charge{67, 157, 255, 240};
    80	
    81	    SDL_SetRenderDrawBlendMode(renderer_, SDL_BLENDMODE_BLEND);
    82	
    83	    // Original speaker cabinet and flared cone.
    84	    set_color(renderer_, body);
    85	    SDL_Rect cabinet{25, 33, 8, 14};
    86	    SDL_RenderFillRect(renderer_, &cabinet);
    87	
    88	    for (int y = 27; y <= 52; ++y) {
    89	        int left = 33;
    90	        if (y < 33) {
    91	            left += (33 - y) * 11 / 6;
    92	        } else if (y > 46) {
    93	            left += (y - 46) * 11 / 6;
    94	        }
    95	        SDL_RenderDrawLine(renderer_, left, y, 44, y);
    96	    }
    97	
    98	    // Original two curved sound waves.
    99	    const auto draw_arc = [&](int radius) {
   100	        constexpr double pi = 3.14159265358979323846;
   101	        const int steps = std::max(2, radius * 2);
   102	        SDL_Point previous{};
   103	        for (int step = 0; step <= steps; ++step) {
   104	            const double degrees = -50.0 + 100.0 * step / steps;
   105	            const double radians = degrees * pi / 180.0;
   106	            SDL_Point point{
   107	                47 + static_cast<int>(std::lround(radius * std::cos(radians))),
   108	                39 + static_cast<int>(std::lround(radius * std::sin(radians)))
   109	            };
   110	            if (step > 0) {
   111	                SDL_RenderDrawLine(renderer_, previous.x, previous.y,
   112	                                   point.x, point.y);
   113	            }
   114	            previous = point;
   115	        }
   116	    };
   117	    set_color(renderer_, waves);
   118	    draw_arc(6);
   119	    draw_arc(12);
   120	
   121	    // Original battery outline, terminal, and charge fill.
   122	    set_color(renderer_, body);
   123	    SDL_Rect battery{657, 27, 34, 19};
   124	    SDL_Rect terminal{691, 33, 4, 7};
   125	    SDL_RenderDrawRect(renderer_, &battery);
   126	    SDL_RenderFillRect(renderer_, &terminal);
   127	
   128	    set_color(renderer_, charge);
   129	    SDL_Rect fill{661, 31, 22, 11};
   130	    SDL_RenderFillRect(renderer_, &fill);
   131	
   132	    // Original wordmark dimensions and placement.
   133	    if (logo_) {
   134	        SDL_Rect destination{195, 5, 330, 61};
   135	        SDL_RenderCopy(renderer_, logo_, nullptr, &destination);
   136	    }
   137	}
   138	
   139	void SharedShell::render_footer(bool selected_game) {
   140	    if (!renderer_ || selected_game) return;
   141	
   142	    // The carousel keeps its original full-width navigation artwork.
   143	    if (hints_) {
   144	        SDL_Rect destination{0, 682, 720, 34};
   145	        SDL_RenderCopy(renderer_, hints_, nullptr, &destination);
   146	    }
   147	}
   148	
   149	void SharedShell::reset() noexcept {
   150	    if (logo_) {
   151	        SDL_DestroyTexture(logo_);
   152	        logo_ = nullptr;
   153	    }
   154	    if (hints_) {
   155	        SDL_DestroyTexture(hints_);
   156	        hints_ = nullptr;
   157	    }
   158	    if (font_) {
   159	        TTF_CloseFont(font_);
   160	        font_ = nullptr;
   161	    }
   162	    renderer_ = nullptr;
   163	}
   164	
   165	} // namespace kiddos::app
