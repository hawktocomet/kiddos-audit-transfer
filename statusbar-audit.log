    11	// Non-owning SDL2 renderer adapter.
    12	// The SDLPlatform remains responsible for creating and destroying SDL_Renderer.
    13	class Renderer final {
    14	public:
    15	    explicit Renderer(SDL_Renderer* renderer = nullptr) noexcept;
    16	
    17	    void attach(SDL_Renderer* renderer) noexcept;
    18	    bool valid() const noexcept;
    19	
    20	    bool clear(Color color) const;
    21	    bool fill_rect(Rect rect, Color color) const;
    22	    bool outline_rect(Rect rect, Color color) const;
    23	    bool draw_line(Point from, Point to, Color color) const;
    24	    bool draw_point(Point point, Color color) const;
    25	    bool draw_texture(SDL_Texture* texture, Rect source, Rect destination,
    26	                      std::uint8_t opacity = 255) const;
    27	    bool fill_rounded_rect(Rect rect, int radius, Color color) const;
    28	    bool outline_rounded_rect(Rect rect, int radius, Color color) const;
    29	
    30	    bool set_clip(Rect rect) const;
    31	    bool clear_clip() const;
    32	
    33	    void present() const;
    34	
    35	    SDL_Renderer* native() const noexcept;
    36	
    37	private:
    38	    SDL_Renderer* renderer_ = nullptr;
    39	
    40	    bool set_color(Color color) const;
    41	};
    42	
    43	} // namespace kiddos::ui

