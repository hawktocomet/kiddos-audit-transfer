    71	bool Renderer::draw_texture(
    72	    SDL_Texture* texture,
    73	    Rect source,
    74	    Rect destination,
    75	    std::uint8_t opacity
    76	) const {
    77	    if (!renderer_ || !texture || source.empty() || destination.empty()) return false;
    78	
    79	    Uint8 previous_opacity = 255;
    80	    if (SDL_GetTextureAlphaMod(texture, &previous_opacity) != 0) return false;
    81	    if (SDL_SetTextureAlphaMod(texture, opacity) != 0) return false;
    82	
    83	    SDL_Rect src{source.x, source.y, source.w, source.h};
    84	    SDL_Rect dst{destination.x, destination.y, destination.w, destination.h};
    85	    const bool rendered = SDL_RenderCopy(renderer_, texture, &src, &dst) == 0;
    86	    const bool restored = SDL_SetTextureAlphaMod(texture, previous_opacity) == 0;
    87	
    88	    return rendered && restored;
    89	}
